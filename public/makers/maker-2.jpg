<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#2d3748;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#1a202c;stop-opacity:1" />
    </linearGradient>
    <radialGradient id="faceGrad" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color:#f0f0f0;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#e0e0e0;stop-opacity:1" />
    </radialGradient>
  </defs>
  <rect width="400" height="400" fill="url(#bgGrad)" />

  <!-- Head -->
  <circle cx="200" cy="150" r="80" fill="url(#faceGrad)" />

  <!-- Eyes -->
  <circle cx="170" cy="130" r="10" fill="#333" />
  <circle cx="230" cy="130" r="10" fill="#333" />

  <!-- Eyebrows -->
  <path d="M140 110 Q170 90 200 110" stroke="#555" stroke-width="4" fill="none" />
  <path d="M200 110 Q230 90 260 110" stroke="#555" stroke-width="4" fill="none" />

  <!-- Nose -->
  <path d="M200 140 L200 160" stroke="#555" stroke-width="2" />
  <path d="M195 160 L205 160" stroke="#555" stroke-width="2" />

  <!-- Mouth -->
  <path d="M170 190 Q200 210 230 190" stroke="#555" stroke-width="2" fill="none" />

  <!-- Hair -->
  <path d="M120 80 Q200 20 280 80 Q300 120 280 160 Q200 200 120 160 Q100 120 120 80 Z" fill="#333" opacity="0.8" />

  <!-- Suit -->
  <rect x="120" y="220" width="160" height="160" rx="12" fill="#4a5568" />

  <!-- Shirt -->
  <rect x="140" y="240" width="120" height="100" rx="8" fill="#e2e8f0" />

  <!-- Tie -->
  <rect x="190" y="240" width="20" height="80" rx="4" fill="#ff6b6b" />

  <!-- Text -->
  <text x="50%" y="370" dominant-baseline="middle" text-anchor="middle"
        fill="#ffffff" font-size="16" font-family="Arial, sans-serif" opacity="0.8">
    محمد کریمی
  </text>
</svg>