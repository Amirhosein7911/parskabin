<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 400">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#2d3748;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#1a202c;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="800" height="400" fill="url(#bgGrad)" />

  <!-- Modern kitchen -->
  <rect x="100" y="100" width="600" height="250" rx="12" fill="#2d3748" />
  <rect x="120" y="120" width="560" height="30" rx="6" fill="#4a5568" />
  <rect x="120" y="160" width="160" height="30" rx="6" fill="#4a5568" />
  <rect x="320" y="160" width="160" height="30" rx="6" fill="#4a5568" />
  <rect x="520" y="160" width="160" height="30" rx="6" fill="#4a5568" />
  <rect x="120" y="200" width="80" height="30" rx="6" fill="#4a5568" />
  <rect x="220" y="200" width="80" height="30" rx="6" fill="#4a5568" />
  <rect x="320" y="200" width="80" height="30" rx="6" fill="#4a5568" />
  <rect x="420" y="200" width="80" height="30" rx="6" fill="#4a5568" />
  <rect x="520" y="200" width="80" height="30" rx="6" fill="#4a5568" />
  <rect x="620" y="200" width="80" height="30" rx="6" fill="#4a5568" />

  <!-- Countertop -->
  <rect x="100" y="80" width="600" height="20" rx="4" fill="#e2e8f0" />

  <!-- Text -->
  <text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle"
        fill="#ffffff" font-size="24" font-family="Arial, sans-serif" opacity="0.7">
    Modern Kitchen Project
  </text>
</svg>