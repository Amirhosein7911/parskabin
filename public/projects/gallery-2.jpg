<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#2d3748;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#1a202c;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="600" height="400" fill="url(#bgGrad)" />

  <!-- Kitchen island detail -->
  <circle cx="300" cy="200" r="80" fill="#4a5568" opacity="0.8" />
  <rect x="200" y="100" width="200" height="200" rx="8" fill="#2d3748" />
  <rect x="220" y="120" width="160" height="160" rx="6" fill="#4a5568" opacity="0.9" />

  <!-- Countertop -->
  <rect x="100" y="80" width="400" height="20" rx="4" fill="#e2e8f0" />

  <!-- Text -->
  <text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle"
        fill="#ffffff" font-size="16" font-family="Arial, sans-serif" opacity="0.7">
    Kitchen Island Detail
  </text>
</svg>